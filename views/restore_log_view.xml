<odoo>
    
    <!-- Tree view to list logs -->
    <record id="view_log_restore_tree" model="ir.ui.view">
        <field name="name">log.restore.tree</field>
        <field name="model">excise.log.restore</field>
        <field name="arch" type="xml">
            <tree>
                <field name="log_line"/>
            </tree>
        </field>
    </record>

    <!-- Define the action for viewing the logs -->
    <record id="action_restore_logs" model="ir.actions.act_window">
        <field name="name">Restore Logs</field>
        <field name="res_model">excise.log.restore</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_log_restore_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                There are no log records yet.
            </p>
        </field>
    </record>

    <!-- Define the menu item to access the logs -->
    <menuitem id="excise_log_restore_menu" 
        name="Restore Logs" 
        action="action_restore_logs"
        parent="stock.menu_warehouse_report" sequence="350"/>


    <!-- Form view to display logs in detail with a button to fetch logs -->
    <record id="view_log_restore_form" model="ir.ui.view">
        <field name="name">log.restore.form</field>
        <field name="model">excise.log.restore</field>
        <field name="arch" type="xml">
            <form string="Restore Log">
                <header>
                    <button name="action_fetch_logs" type="object" string="Fetch Logs" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="log_line"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>